/debian/.debhelper/
/debian/cubie-a7z-fanctl/
/debian/tmp/
/debian/debhelper-build-stamp
/debian/files
/debian/*.substvars
/debian/*.debhelper
/debian/*.debhelper.log
/dist/
*.deb
*.ddeb
*.buildinfo
*.changes
*.orig.tar.*
*.debian.tar.*

# Python caches and OS/editor temporary files.
__pycache__/
*.py[cod]
.DS_Store
*~
*.swp
*.swo

# Device-tree overlay build output.
/contrib/armbian/*.dtbo
