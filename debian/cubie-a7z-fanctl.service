[Unit]
Description=Cubie A7Z PWM fan controller
Documentation=man:cubie-a7z-fanctl(8)
After=local-fs.target
ConditionPathExists=/sys/class/hwmon

[Service]
Type=simple
ExecStart=/usr/sbin/cubie-a7z-fanctl --config /etc/cubie-a7z-fanctl/config.toml
Restart=on-failure
RestartSec=5
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
